{
  "manifest_version": 3,
  "name": "TabTree",
  "description": "Visualize your browsing history as a branching tree",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120"
}
